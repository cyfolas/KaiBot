# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен бота: Developer Portal → Bot → Reset Token.
DISCORD_TOKEN=

# Необязательно. Разработчики бота — ID пользователей через запятую.
# Участники команды приложения (Developer Portal → Teams) или, если команды нет, его владелец
# добавляются автоматически. Если перенести приложение в команду, переменную можно не заполнять.
BOT_DEVELOPERS=

# Необязательно. Уровень журнала (по умолчанию: info,kaibot=debug).
# RUST_LOG=info

# Необязательно. Прокси для REST API (http://, socks5://, socks5h://).
# Gateway (WebSocket) подключается напрямую — serenity 0.12 не поддерживает для него прокси.
# HTTPS_PROXY=socks5h://127.0.0.1:1080
